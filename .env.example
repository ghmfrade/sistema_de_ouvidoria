POSTGRES_USER=seu_usuario
POSTGRES_PASSWORD=sua_senha
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=souvi
POSTGRES_SCHEMA=ouvidoria

# ── API ───────────────────────────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque_por_uma_chave_segura

# ── API ──────────────────────────────────────────────────────────────────────
# URL base da API FastAPI — usada pelo Python no servidor (chamadas internas).
API_BASE_URL=http://127.0.0.1:8000

# URL pública da API — usada em links enviados ao browser do usuário.
# Em produção, defina com o IP/domínio externo do servidor.
API_PUBLIC_URL=http://IP_DO_SERVIDOR:8000

# ── Dashboard de Qualidade ────────────────────────────────────────────────────
# URL onde o servidor Dash (qualidade_dash) está rodando.
# Em produção, substitua pelo endereço público ou interno do servidor.
DASH_URL=http://localhost:8050

# ── Caddy (reverse proxy) ─────────────────────────────────────────────────────
# Subdomínios servidos pelo Caddy. Em prod, apontar DNS para o host do Caddy.
FRONTEND_DOMAIN=souvi.artesp.sp.gov.br
API_DOMAIN=api.souvi.artesp.sp.gov.br
PAINEL_DOMAIN=painel.souvi.artesp.sp.gov.br
# Email para Let's Encrypt (se trocar `tls internal` por `tls {email}` no Caddyfile)
CADDY_LE_EMAIL=admin@artesp.sp.gov.br

# ── Testes (unitários / integração local) ────────────────────────────────────
# Os usuários de teste são criados/deletados automaticamente pelo conftest.py.
# Ajuste TEST_OUVIDORIA_ID para o ID de uma ouvidoria existente no banco de dev.
TEST_OUVIDORIA_ID=1

# ── Testes de integração (tests/integration/) ─────────────────────────────────
# Testam a API rodando no servidor real via HTTP.
# Sem essas variáveis os testes de integração são pulados automaticamente.
TEST_SERVER_URL=http://10.23.42.237:8000
TEST_SERVER_EMAIL=email_de_um_gestor@artesp.sp.gov.br
TEST_SERVER_PASSWORD=senha_do_gestor
